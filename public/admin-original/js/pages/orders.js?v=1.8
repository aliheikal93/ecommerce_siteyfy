            </div>
            <div style="flex: 1;">
                <div style="font-weight: 600; font-size: 0.9rem;">${getOrderItemDisplayName(item)}</div>
                ${getOrderItemMeta(item).map(line => `<div style="font-size: 0.8rem; color: var(--text-muted); margin-top: 2px;">${line}</div>`).join('')}
                <div style="font-size: 0.8rem; color: var(--text-muted); margin-top: 4px;">${window.i18n.t('orders.qty')} ${item.quantity} &times; ${parseFloat(item.unitPrice || item.price).toFixed(2)} EGP</div>
            </div>
            <div style="font-weight: 700;">${parseFloat(item.lineTotal || (item.quantity * parseFloat(item.price))).toFixed(2)} EGP</div>
        </div>
    `).join('');

    content.innerHTML = `
        <div style="display: grid; grid-template-columns: 1fr 1fr; gap: 1.5rem; margin-bottom: 1.5rem;">
            <div class="order-info-card">
                <h4 style="margin-bottom: 1rem; color: var(--primary); border-bottom: 1px solid rgba(255,255,255,0.1); padding-bottom: 0.5rem;">
                    <i class="fa-solid fa-user-tag"></i> ${window.i18n.t('orders.customerInfo')}
                </h4>
                <p><strong>${window.i18n.t('orders.name')}</strong> ${order.customerDisplayName || `${order.guestFirstName || 'N/A'} ${order.guestLastName || ''}`}</p>
                <p><strong>${window.i18n.t('orders.phone')}</strong> ${order.guestPhone || order.user?.phone || 'N/A'}</p>
                <p><strong>${window.i18n.t('orders.email')}</strong> ${order.guestEmail || order.user?.email || 'N/A'}</p>
                <p><strong>${window.i18n.t('orders.governorate')}</strong> ${getLocalizedEntityName(order.governorate)}</p>
                <p><strong>${window.i18n.t('orders.area')}</strong> ${getLocalizedEntityName(order.area)}</p>
                <p><strong>${window.i18n.t('orders.street')}</strong> ${order.street || 'N/A'}</p>
                <p><strong>${window.i18n.t('orders.bldg')}</strong> ${order.buildingNumber || 'N/A'} | <strong>${window.i18n.t('orders.floor')}</strong> ${order.floorNumber || 'N/A'} | <strong>${window.i18n.t('orders.apt')}</strong> ${order.apartmentNumber || 'N/A'}</p>
                ${order.deliveryNotes ? `<p><strong>${window.i18n.t('orders.notes')}</strong> ${order.deliveryNotes}</p>` : ''}
                <p style="margin-top:0.5rem; font-size:0.8rem; color:var(--text-muted); opacity:0.6;"><em>${window.i18n.t('orders.fullAddress')} ${order.shippingAddress || 'N/A'}</em></p>
            </div>
            <div class="order-info-card">
                <h4 style="margin-bottom: 1rem; color: var(--primary); border-bottom: 1px solid rgba(255,255,255,0.1); padding-bottom: 0.5rem;">
                    <i class="fa-solid fa-clipboard-list"></i> ${window.i18n.t('orders.orderStatus')}
                </h4>
                <div class="form-group">
                    <label>${window.i18n.t('orders.changeStatus')}</label>
                    <select id="modal-order-status" class="input-control" style="width: 100%; padding: 0.8rem; border-radius: 8px;">
                        <option value="PENDING" ${order.status === 'PENDING' ? 'selected' : ''}>${window.i18n.t('orders.statusPendingShort')}</option>
                        <option value="PROCESSING" ${order.status === 'PROCESSING' ? 'selected' : ''}>${window.i18n.t('orders.statusProcessingShort')}</option>
                        <option value="SHIPPED" ${order.status === 'SHIPPED' ? 'selected' : ''}>${window.i18n.t('orders.statusShippedShort')}</option>
                        <option value="DELIVERED" ${order.status === 'DELIVERED' ? 'selected' : ''}>${window.i18n.t('orders.statusDeliveredShort')}</option>
                        <option value="CANCELLED" ${order.status === 'CANCELLED' ? 'selected' : ''}>${window.i18n.t('orders.statusCancelledShort')}</option>
                        <option value="RETURNED" ${order.status === 'RETURNED' ? 'selected' : ''}>${window.i18n.t('orders.statusReturnedShort')}</option>
                    </select>
                </div>
                <button class="btn btn-primary btn-block" onclick="updateOrderStatus('${order.id}')" id="btn-update-status" style="margin-top: 1rem;">
                    ${window.i18n.t('orders.updateStatus')}

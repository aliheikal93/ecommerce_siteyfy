/**
 * Orders Management Component
 */

window.ordersState = {
    orders: [],
    page: 1,
    limit: 20,
    status: '',
    search: '',
    isLoading: false,
    selectedOrder: null
};

function getLocalizedEntityName(entity) {
    if (!entity) return 'N/A';
    if (window.i18n.currentLang === 'ar') {
        return entity.nameAr || entity.name_ar || entity.nameEn || entity.name_en || 'N/A';
    }
    return entity.nameEn || entity.name_en || entity.nameAr || entity.name_ar || 'N/A';
}

function getOrderItemDisplayName(item) {
    return (
        (window.i18n.currentLang === 'ar'
            ? item.displayNameAr || item.productDetails?.displayNameAr
            : item.displayName || item.productDetails?.displayNameEn) ||
        item.product?.model ||
        item.product?.modelAr ||
        item.productDetails?.displayNameEn ||
        `Product #${item.productId}`
    );
}

function getOrderItemMeta(item) {
    const lines = [];
    const brandName = window.i18n.currentLang === 'ar'
        ? item.productDetails?.brandNameAr || item.product?.brand?.nameAr || item.product?.brandAr
        : item.productDetails?.brandNameEn || item.product?.brand?.nameEn || item.product?.brandEn;
    const categoryName = window.i18n.currentLang === 'ar'
        ? item.productDetails?.categoryNameAr || item.product?.category?.nameAr
        : item.productDetails?.categoryNameEn || item.product?.category?.nameEn;
    const variantSummary = window.i18n.currentLang === 'ar'
        ? item.variantInfo?.summaryAr
        : item.variantInfo?.summaryEn;

    if (brandName) lines.push(brandName);
    if (categoryName) lines.push(categoryName);
    if (variantSummary) lines.push(variantSummary);
    if (item.variantInfo?.sku) lines.push(`SKU: ${item.variantInfo.sku}`);

    return lines;
}


window.setupOrdersEvents = async () => {
    fetchOrdersStats();
    fetchAndRenderOrders();

    // Filters
    document.getElementById('btn-apply-order-filters').addEventListener('click', () => {
        window.ordersState.page = 1;
        fetchAndRenderOrders();
    });

    document.getElementById('btn-clear-order-filters').addEventListener('click', () => {
        document.getElementById('order-filter-search').value = '';
        document.getElementById('order-filter-status').value = '';
        window.ordersState.page = 1;
        fetchAndRenderOrders();
    });

    // Pagination
    document.getElementById('btn-order-prev').addEventListener('click', () => {
        if (window.ordersState.page > 1) {
            window.ordersState.page--;
            fetchAndRenderOrders();
        }
    });

    document.getElementById('btn-order-next').addEventListener('click', () => {
        window.ordersState.page++;
        fetchAndRenderOrders();
    });

    // Modal Close
    document.getElementById('close-order-modal').addEventListener('click', () => {
        document.getElementById('order-detail-modal').classList.remove('show');
    });
};

async function fetchOrdersStats() {
    try {
        const res = await window.api.get('/api/admin/orders/orders-stats');
        const data = res.data || res;
        const stats = data.stats || data;
        const container = document.getElementById('orders-stats-container');
        if (!container) return;

        container.innerHTML = `
            <div class="stat-mini-card">
                <span class="value">${stats.totalOrders || 0}</span>
                <span class="label">${window.i18n.t('orders.statTotal')}</span>
            </div>
            <div class="stat-mini-card">
                <span class="value" style="color:#f59e0b">${stats.pendingOrders || 0}</span>
                <span class="label">${window.i18n.t('orders.statPending')}</span>
            </div>
            <div class="stat-mini-card">
                <span class="value" style="color:#3b82f6">${stats.processingOrders || 0}</span>
                <span class="label">${window.i18n.t('orders.statProcessing')}</span>
            </div>
            <div class="stat-mini-card">
                <span class="value" style="color:#10b981">${stats.deliveredOrders || 0}</span>
                <span class="label">${window.i18n.t('orders.statCompleted')}</span>
            </div>
        `;
    } catch (e) {
        console.error('Stats loading failed', e);
    }
}

async function fetchAndRenderOrders() {
    const tbody = document.getElementById('orders-tbody');
    tbody.innerHTML = `<tr><td colspan="6" style="text-align: center;"><i class="fa-solid fa-spinner fa-spin"></i> ${window.i18n.t('orders.loading')}</td></tr>`;

    try {
        const search = document.getElementById('order-filter-search').value.trim();
        const status = document.getElementById('order-filter-status').value;
        const { page, limit } = window.ordersState;

        let url = `/api/admin/orders?page=${page}&limit=${limit}`;
        if (search) url += `&search=${encodeURIComponent(search)}`;
        if (status) url += `&status=${status}`;

        const response = await window.api.get(url);
        const data = response.data || response;
        const orders = data.orders || [];

        window.ordersState.orders = orders;

        if (orders.length === 0) {
            tbody.innerHTML = `<tr><td colspan="6" style="text-align: center;">${window.i18n.t('orders.noOrdersFound')}</td></tr>`;
        } else {
            tbody.innerHTML = orders.map(order => `
                <tr>
                    <td><span style="font-family: monospace; font-weight: 600;">${order.id.substring(0, 10)}...</span></td>
                    <td>
                        <div style="font-weight: 600;">${order.guestFirstName || 'Member'} ${order.guestLastName || ''}</div>
                        <div style="font-size: 0.8rem; color: var(--text-muted);">${order.guestPhone || order.guestEmail || 'N/A'}</div>
                    </td>
                    <td style="font-weight: 700; color: var(--primary);">${parseFloat(order.total).toFixed(2)} EGP</td>
                    <td><span class="status-badge status-${order.status.toLowerCase()}">${window.i18n.t('orders.status' + order.status.charAt(0) + order.status.slice(1).toLowerCase() + 'Short') || order.status}</span></td>
                    <td><div style="font-size: 0.85rem;">${new Date(order.createdAt).toLocaleDateString()}</div></td>
                    <td style="text-align: right;">
                        <div style="display: flex; gap: 0.3rem; justify-content: flex-end; flex-wrap: wrap;">
                            <!-- Primary Status Transition -->
                            ${order.status === 'PENDING' ? `
                                <button class="btn btn-sm btn-status-accept" onclick="quickUpdateStatus('${order.id}', 'PENDING', 'PROCESSING')" title="Accept">
                                    <i class="fa-solid fa-check"></i> ${window.i18n.t('orders.actionAccept')}
                                </button>
                            ` : ''}
                            ${order.status === 'PROCESSING' ? `
                                <button class="btn btn-sm btn-status-ship" onclick="quickUpdateStatus('${order.id}', 'PROCESSING', 'SHIPPED')" title="Ship">
                                    <i class="fa-solid fa-truck"></i> ${window.i18n.t('orders.actionShip')}
                                </button>
                            ` : ''}
                            ${order.status === 'SHIPPED' ? `
                                <button class="btn btn-sm btn-status-deliver" onclick="quickUpdateStatus('${order.id}', 'SHIPPED', 'DELIVERED')" title="Deliver">
                                    <i class="fa-solid fa-house-chimney"></i> ${window.i18n.t('orders.actionDeliver')}
                                </button>
                            ` : ''}

                            <!-- View Details -->
                            <button class="btn btn-sm btn-info" onclick="viewOrderDetails('${order.id}')" title="${window.i18n.t('orders.actionView')}">
                                <i class="fa-solid fa-eye"></i>
                            </button>

                            <!-- Destructive Actions -->
                            ${['PENDING', 'PROCESSING'].includes(order.status) ? `
                                <button class="btn btn-sm btn-status-cancel" onclick="quickUpdateStatus('${order.id}', '${order.status}', 'CANCELLED')" title="${window.i18n.t('orders.actionCancel')}">
                                    <i class="fa-solid fa-ban"></i>
                                </button>
                            ` : ''}
                            ${order.status === 'DELIVERED' ? `
                                <button class="btn btn-sm btn-status-return" onclick="quickUpdateStatus('${order.id}', 'DELIVERED', 'RETURNED')" title="${window.i18n.t('orders.actionReturn')}">
                                    <i class="fa-solid fa-rotate-left"></i>
                                </button>
                            ` : ''}
                        </div>
                    </td>
                </tr>
            `).join('');
        }

        // Update pagination
        const paginationInfo = document.getElementById('order-pagination-info');
        paginationInfo.textContent = `${window.i18n.t('orders.showingPage')}${page}${data.pagination?.total ? window.i18n.t('orders.showingPageTotal') + data.pagination.total + ')' : ''}`;
        document.getElementById('btn-order-prev').disabled = page <= 1;
        document.getElementById('btn-order-next').disabled = orders.length < limit;

    } catch (e) {
        tbody.innerHTML = `<tr><td colspan="6" style="text-align: center; color: var(--danger);">Error: ${e.message}</td></tr>`;
    }
}

window.viewOrderDetails = async (id) => {
    const order = window.ordersState.orders.find(o => o.id === id);
    if (!order) return;

    window.ordersState.selectedOrder = order;
    const modal = document.getElementById('order-detail-modal');
    const content = document.getElementById('order-detail-content');

    document.getElementById('order-detail-title').textContent = `${window.i18n.t('orders.orderDetailsTitle')}: ${order.id.substring(0, 8)}`;
    modal.classList.add('show');

    // Loading items if not present (usually they should be there from the list API if it's broad enough)
    // If items aren't nested, we'd fetch them here.

    renderOrderModalContent(order);
};

function renderOrderModalContent(order) {

window.updateOrderStatus = async (id) => {
    const newStatus = document.getElementById('modal-order-status').value;
    const oldStatus = window.ordersState.selectedOrder?.status || 'UNKNOWN';
    await performStatusUpdate(id, oldStatus, newStatus);
    document.getElementById('order-detail-modal').classList.remove('show');
};

window.quickUpdateStatus = async (id, oldStatus, newStatus) => {
    // No confirmation as requested by user
    await performStatusUpdate(id, oldStatus, newStatus);
};

async function performStatusUpdate(id, oldStatus, newStatus) {
    const btn = document.getElementById('btn-update-status');
    const origText = btn ? btn.textContent : '';

    try {
        if (btn) {
            btn.innerHTML = `<i class="fa-solid fa-spinner fa-spin"></i> ${window.i18n.t('orders.updating')}`;
            btn.disabled = true;
        }

        const apiMethod = window.api.patch ? 'patch' : 'put';
        await window.api[apiMethod](`/api/admin/orders/${id}/status`, { status: newStatus });

        window.app.showToast(`${window.i18n.t('orders.statusUpdated')} ${window.i18n.t('orders.status' + oldStatus.charAt(0) + oldStatus.slice(1).toLowerCase() + 'Short') || oldStatus} &rarr; ${window.i18n.t('orders.status' + newStatus.charAt(0) + newStatus.slice(1).toLowerCase() + 'Short') || newStatus}`);

        // Refresh lists and stats
        await fetchAndRenderOrders();
        await fetchOrdersStats();

    } catch (e) {
        window.app.showToast(e.message, 'error');
    } finally {
        if (btn) {
            btn.innerHTML = origText;
            btn.disabled = false;
        }
    }
}

window.setupProductsEvents = async () => {
    // 1. Initial Data Fetch
    await fetchRelations();
    await fetchAndRenderProducts();

    // 2. Tab Navigation Logic
    const tabBtns = document.querySelectorAll('.tab-btn');
    const tabContents = document.querySelectorAll('.tab-content');

    tabBtns.forEach(btn => {
        btn.addEventListener('click', () => {
            // Remove active classes
            tabBtns.forEach(b => {
                b.classList.remove('active');
                b.style.color = 'var(--text-muted)';
                b.style.borderBottom = 'none';
            });
            tabContents.forEach(c => c.style.display = 'none');

            // Add active class
            btn.classList.add('active');
            btn.style.color = 'var(--text-main)';
            btn.style.borderBottom = '2px solid var(--primary)';
            document.getElementById(btn.dataset.target).style.display = 'block';
        });
    });

    // 3. Variant Checkbox Logic
    const variantToggle = document.getElementById('prod-has-variants');
    const flatPricing = document.getElementById('flat-pricing-section');
    const variantsBuilder = document.getElementById('variants-builder-section');

    variantToggle.addEventListener('change', (e) => {
        window.productsState.hasVariants = e.target.checked;
        if (e.target.checked) {
            flatPricing.style.display = 'none';
            variantsBuilder.style.display = 'block';
            if (window.productsState.productOptions.length === 0) {
                addVariantRow();
            }
        } else {
            flatPricing.style.display = 'block';
            variantsBuilder.style.display = 'none';
        }
    });

    // 4. Variant Row Management
    document.getElementById('btn-add-variant-row').addEventListener('click', () => {
        addVariantRow();
    });

    // 5. Image Preview Logic
    document.getElementById('prod-main-img').addEventListener('change', (e) => {
        const file = e.target.files[0];
        if (file) {
            window.productsState.mainPhotoFile = file;
            const reader = new FileReader();
            reader.onload = e => document.getElementById('prod-main-img-preview').src = e.target.result;
            reader.readAsDataURL(file);
        }
    });

    document.getElementById('prod-side-imgs').addEventListener('change', (e) => {
        const files = Array.from(e.target.files).slice(0, 8); // Max 8
        window.productsState.sidePhotosFiles = files;

        const previewContainer = document.getElementById('prod-side-imgs-preview');
        previewContainer.innerHTML = '';

        files.forEach(file => {
            const reader = new FileReader();
            reader.onload = ev => {
                previewContainer.innerHTML += `
                    <div style="width: 60px; height: 60px; border-radius: 4px; overflow: hidden; border: 1px solid var(--border-color);">
                        <img src="${ev.target.result}" style="width: 100%; height: 100%; object-fit: cover;">
                    </div>
                `;
            };
            reader.readAsDataURL(file);
        });
    });

    // 6. Modal Controls
    const modal = document.getElementById('product-modal');
    const closeModal = () => {
        modal.classList.remove('show');
        resetProductForm();
    };

    document.getElementById('btn-add-product').addEventListener('click', () => {
        document.getElementById('product-modal-title').textContent = window.i18n.t('products.addProduct');
        modal.classList.add('show');
        // Reset to first tab
        tabBtns[0].click();
    });

    document.getElementById('close-product-modal').addEventListener('click', closeModal);
    document.getElementById('btn-cancel-product').addEventListener('click', closeModal);
    document.getElementById('btn-products-trash').addEventListener('click', () => {
        window.openProductsTrash();
    });
    document.getElementById('close-products-trash').addEventListener('click', closeProductsTrashModal);
    document.getElementById('btn-close-products-trash').addEventListener('click', closeProductsTrashModal);
    document.getElementById('btn-products-trash-prev').addEventListener('click', async () => {
        if (window.productsState.trashPage > 1) {
            window.productsState.trashPage--;
            await loadTrashProducts();
        }
    });
    document.getElementById('btn-products-trash-next').addEventListener('click', async () => {
        window.productsState.trashPage++;
        await loadTrashProducts();
    });

    // 7. Save Product (Massive API Call)
    document.getElementById('btn-save-product').addEventListener('click', saveProduct);

    // 8. Filters & Search Pagination
    document.getElementById('btn-apply-filters').addEventListener('click', async () => {
        window.productsState.page = 1; // Reset to page 1 on new filter
        await fetchAndRenderProducts();
    });

    document.getElementById('btn-clear-filters').addEventListener('click', async () => {
        document.getElementById('filter-search').value = '';
        document.getElementById('filter-category').value = '';
        document.getElementById('filter-brand').value = '';
        document.getElementById('filter-color').value = '';
        document.getElementById('filter-label').value = '';
        document.getElementById('filter-status').value = '';
        window.productsState.page = 1;
        await fetchAndRenderProducts();
    });

    // Press Enter to Search
    document.getElementById('filter-search').addEventListener('keypress', async (e) => {
        if (e.key === 'Enter') {
            window.productsState.page = 1;
            await fetchAndRenderProducts();
        }
    });

    // Pagination (from ancient iteration)
    document.getElementById('btn-prod-prev').addEventListener('click', async () => {
        if (window.productsState.page > 1) {
            window.productsState.page--;
            await fetchAndRenderProducts();
        }
    });

    document.getElementById('btn-prod-next').addEventListener('click', async () => {
        window.productsState.page++;
        await fetchAndRenderProducts();
    });
};

/* --- CORE DATA FETCHERS --- */
async function fetchRelations() {
    try {
        // Fetch Categories
        const catRes = await window.api.get('/api/admin/categories');
        window.productsState.categories = Array.isArray(catRes) ? catRes : (catRes.categories || []);

        // Fetch Brands (using new un-deprecated route logic if needed, but standard is fine)
        const brandRes = await window.api.get('/api/admin/brands');
        window.productsState.brands = Array.isArray(brandRes) ? brandRes : (brandRes.brands || []);

        // Fetch Labels
        const labelRes = await window.api.get('/api/admin/labels');
        window.productsState.labels = Array.isArray(labelRes) ? labelRes : (labelRes.labels || []);

        // Fetch Colors
        const colorRes = await window.api.get('/api/admin/colors');
        window.productsState.colors = Array.isArray(colorRes) ? colorRes : (colorRes.colors || []);

        // Fetch Options (Sizes/etc)
        const optRes = await window.api.get('/api/admin/options');
        window.productsState.options = Array.isArray(optRes) ? optRes : (optRes.options || []);

        populateSelects();
    } catch (e) {
        console.error("Failed to fetch relations:", e);
    }
}

function populateSelects() {
    const lang = window.i18n.currentLang || 'en';
    
    // Categories
    const catSelect = document.getElementById('prod-category');
    catSelect.innerHTML = `<option value="">${window.i18n.t('products.selectCategory')}</option>` +
        window.productsState.categories.map(c => `<option value="${c.id}">${lang === 'ar' ? (c.name_ar || c.nameAr || c.nameEn || c.name_en || c.name) : (c.name_en || c.nameEn || c.name)}</option>`).join('');

    // Brands
    const brandSelect = document.getElementById('prod-brand');
    brandSelect.innerHTML = `<option value="">${window.i18n.t('products.selectBrand')}</option>` +
        window.productsState.brands.map(b => `<option value="${b.id}">${lang === 'ar' ? (b.name_ar || b.nameAr || b.nameEn || b.name_en || b.name) : (b.name_en || b.nameEn || b.name)}</option>`).join('');

    // Labels Checkboxes Model
    const labelsContainer = document.getElementById('prod-labels-container');
    labelsContainer.innerHTML = window.productsState.labels.map(l => `
        <label style="display:flex; align-items:center; gap:4px; margin:0; padding:4px 8px; background:rgba(255,255,255,0.05); border-radius:4px; cursor:pointer;">
            <input type="checkbox" class="prod-label-chk" value="${l.id}">
            <span style="color:${l.color};">${lang === 'ar' ? (l.name_ar || l.name_en) : (l.name_en || l.name_ar)}</span>
        </label>
    `).join('');

    // --- POPULATE FILTER BAR ---
    const filterCat = document.getElementById('filter-category');
    filterCat.innerHTML = `<option value="">${window.i18n.t('products.allCategories')}</option>` +
        window.productsState.categories.map(c => `<option value="${c.id}">${lang === 'ar' ? (c.name_ar || c.nameAr || c.nameEn || c.name_en || c.name) : (c.name_en || c.nameEn || c.name)}</option>`).join('');

    const filterBrand = document.getElementById('filter-brand');
    filterBrand.innerHTML = `<option value="">${window.i18n.t('products.allBrands')}</option>` +
        window.productsState.brands.map(b => `<option value="${b.id}">${lang === 'ar' ? (b.name_ar || b.nameAr || b.nameEn || b.name_en || b.name) : (b.name_en || b.nameEn || b.name)}</option>`).join('');

    const filterColor = document.getElementById('filter-color');
    filterColor.innerHTML = `<option value="">${window.i18n.t('products.allColors')}</option>` +
        window.productsState.colors.map(c => `<option value="${c.id}">${lang === 'ar' ? (c.name_ar || c.name_en) : (c.name_en || c.name_ar)}</option>`).join('');

    const filterLabel = document.getElementById('filter-label');
    filterLabel.innerHTML = `<option value="">${window.i18n.t('products.allLabels')}</option>` +
        window.productsState.labels.map(l => `<option value="${l.id}">${lang === 'ar' ? (l.name_ar || l.name_en) : (l.name_en || l.name_ar)}</option>`).join('');
}

/* --- VARIANT BUILDER DOM --- */
function addVariantRow(data = null) {
    const container = document.getElementById('variants-container');
    const rowId = 'var_' + Date.now() + Math.random().toString(36).substr(2, 5);

    const lang = window.i18n.currentLang || 'en';

    // Generate Options Select HTML
    const optionsHtml = window.productsState.options.map(o =>
        `<option value="${o.id}" ${data && data.option_id == o.id ? 'selected' : ''}>${lang === 'ar' ? (o.name_ar || o.name_en) : (o.name_en || o.name_ar)} (${o.type || 'SIZE'})</option>`
    ).join('');

    // Generate Colors Select HTML
    const colorsHtml = `<option value="">${window.i18n.t('common.optional')}</option>` + window.productsState.colors.map(c =>
        `<option value="${c.id}" ${data && data.color_id == c.id ? 'selected' : ''}>${lang === 'ar' ? (c.name_ar || c.name_en) : (c.name_en || c.name_ar)}</option>`
    ).join('');

    const row = document.createElement('div');
    row.className = 'variant-row';
    row.id = rowId;
    row.innerHTML = `
        <button type="button" class="remove-row" onclick="document.getElementById('${rowId}').remove()"><i class="fa-solid fa-trash"></i></button>
        <div class="form-row">
            <div class="form-group" style="flex:1;">
                <label>${window.i18n.t('products.optionSize')} <span style="color:red;">*</span></label>
                <select class="input-control var-option-id" required style="width: 100%; padding: 0.5rem; background: rgba(15, 23, 42, 0.6); border: 1px solid var(--border-color); border-radius: 4px; color: var(--text-main);">
                    ${optionsHtml}
                </select>
            </div>
            <div class="form-group" style="flex:1;">
                <label>${window.i18n.t('products.colorOptional')}</label>
                <select class="input-control var-color-id" style="width: 100%; padding: 0.5rem; background: rgba(15, 23, 42, 0.6); border: 1px solid var(--border-color); border-radius: 4px; color: var(--text-main);">
                    ${colorsHtml}
                </select>
            </div>
        </div>
        <div class="form-row">
            <div class="form-group" style="flex:1;">
                <label>${window.i18n.t('products.sellingPriceReq')} <span style="color:red;">*</span></label>
                <input type="number" class="input-control var-price" step="0.01" min="0" value="${data ? (data.price_after || data.price) : ''}" required style="width: 100%; padding: 0.5rem; background: rgba(15, 23, 42, 0.6); border: 1px solid var(--border-color); border-radius: 4px; color: var(--text-main);">
            </div>
            <div class="form-group" style="flex:1;">
                <label>${window.i18n.t('products.priceBefore')}</label>
                <input type="number" class="input-control var-price-before" step="0.01" min="0" value="${data && data.price_before ? data.price_before : ''}" style="width: 100%; padding: 0.5rem; background: rgba(15, 23, 42, 0.6); border: 1px solid var(--border-color); border-radius: 4px; color: var(--text-main);">
            </div>
            <div class="form-group" style="flex:1;">
                <label>${window.i18n.t('products.stockReq')} <span style="color:red;">*</span></label>
                <input type="number" class="input-control var-stock" step="1" min="0" value="${data ? data.stock : 0}" required style="width: 100%; padding: 0.5rem; background: rgba(15, 23, 42, 0.6); border: 1px solid var(--border-color); border-radius: 4px; color: var(--text-main);">
            </div>
        </div>
        <div class="form-group" style="margin-bottom:0;">
            <label>${window.i18n.t('products.variantImage')}</label>
            <input type="hidden" class="var-image" value="${data && data.photos && data.photos.length ? data.photos[0] : ''}">
            <div class="var-image-upload-area" style="display:flex; align-items:center; gap:1rem; margin-top:0.5rem;">
                <div class="var-image-preview" style="width:64px; height:64px; border-radius:8px; border:2px dashed var(--border-color); overflow:hidden; display:flex; align-items:center; justify-content:center; background:rgba(15,23,42,0.6); flex-shrink:0;">
                    ${data && data.photos && data.photos.length
                        ? `<img src="${data.photos[0]}" style="width:100%;height:100%;object-fit:cover;">`
                        : `<i class="fa-solid fa-image" style="color:var(--text-muted);font-size:1.4rem;"></i>`
                    }
                </div>
                <label class="btn btn-outline btn-sm" style="cursor:pointer; margin:0; white-space:nowrap;">
                    <i class="fa-solid fa-upload"></i> ${window.i18n.t('products.uploadImage')}
                    <input type="file" accept="image/*" class="var-image-file" style="display:none;">
                </label>
                <span class="var-image-name" style="font-size:0.8rem; color:var(--text-muted); overflow:hidden; text-overflow:ellipsis; white-space:nowrap;"></span>
                ${data && data.photos && data.photos.length
                    ? `<button type="button" class="btn-icon-sm var-image-remove" title="Remove" style="color:#ef4444;"><i class="fa-solid fa-xmark"></i></button>`
                    : ''
                }
            </div>
        </div>
    `;
    container.appendChild(row);

    // Wire up upload handler for this row
    const fileInput = row.querySelector('.var-image-file');
    fileInput.addEventListener('change', async (e) => {
        const file = e.target.files[0];
        if (!file) return;

        const nameEl = row.querySelector('.var-image-name');
        const previewEl = row.querySelector('.var-image-preview');
        const hiddenInput = row.querySelector('.var-image');

        nameEl.textContent = window.i18n.t('products.uploading');

        try {
            const formData = new FormData();
            formData.append('image', file);
            const res = await window.api.post('/api/admin/upload/single', formData);

            if (res && res.image_url) {
                hiddenInput.value = res.image_url;
                previewEl.innerHTML = `<img src="${res.image_url}" style="width:100%;height:100%;object-fit:cover;">`;
                nameEl.textContent = file.name;

                // Add remove button if not already present
                if (!row.querySelector('.var-image-remove')) {
                    const removeBtn = document.createElement('button');
                    removeBtn.type = 'button';
                    removeBtn.className = 'btn-icon-sm var-image-remove';
                    removeBtn.title = 'Remove';
                    removeBtn.style.color = '#ef4444';
                    removeBtn.innerHTML = '<i class="fa-solid fa-xmark"></i>';
                    removeBtn.addEventListener('click', () => {
                        hiddenInput.value = '';
                        previewEl.innerHTML = '<i class="fa-solid fa-image" style="color:var(--text-muted);font-size:1.4rem;"></i>';
                        nameEl.textContent = '';
                        removeBtn.remove();
                        fileInput.value = '';
                    });
                    row.querySelector('.var-image-upload-area').appendChild(removeBtn);
                }
            }
        } catch (err) {
            nameEl.textContent = window.i18n.t('products.uploadFailed');
            nameEl.style.color = '#ef4444';
            console.error('Variant image upload failed:', err);
        }
    });

    // Wire remove button for rows with existing images
    const removeBtn = row.querySelector('.var-image-remove');
    if (removeBtn) {
        removeBtn.addEventListener('click', () => {
            row.querySelector('.var-image').value = '';
            row.querySelector('.var-image-preview').innerHTML = '<i class="fa-solid fa-image" style="color:var(--text-muted);font-size:1.4rem;"></i>';
            row.querySelector('.var-image-name').textContent = '';
            removeBtn.remove();
            fileInput.value = '';
        });
    }
}

function getVariantDataFromDOM() {
    const rows = document.querySelectorAll('.variant-row');
    const options = [];
    rows.forEach(row => {
        const option_id = row.querySelector('.var-option-id').value;
        const color_id = row.querySelector('.var-color-id').value;
        const price = row.querySelector('.var-price').value;
        const price_before = row.querySelector('.var-price-before').value;
        const stock = row.querySelector('.var-stock').value;
        const image = row.querySelector('.var-image').value;

        if (option_id && price && stock) {
            options.push({
                option_id: parseInt(option_id),
                color_id: color_id ? parseInt(color_id) : null,
                price: parseFloat(price),
                price_after: parseFloat(price),
                price_before: price_before ? parseFloat(price_before) : null,
                stock: parseInt(stock),
                photos: image ? [image] : []
            });
        }
    });
    return options;
}

/* --- SAVE WORKFLOW --- */
async function saveProduct() {
    // 1. Gather Basic Fields
    const model = document.getElementById('prod-model').value.trim();
    const modelAr = document.getElementById('prod-model-ar').value.trim();
    const gender = document.getElementById('prod-gender').value;
    const isActive = document.getElementById('prod-is-active').value === 'true';
    const descEn = document.getElementById('prod-desc-en').value.trim();
    const descAr = document.getElementById('prod-desc-ar').value.trim();
    const categoryId = document.getElementById('prod-category').value;
    const brandId = document.getElementById('prod-brand').value;

    if (!model || !categoryId || !brandId) {
        window.app.showToast(window.i18n.t('products.errModelCatBrand'), 'warning');
        // Switch to taxonomy tab if it's the missing one
        if (model && (!categoryId || !brandId)) document.querySelector('[data-target="tab-taxonomy"]').click();
        return;
    }

    const hasMainImage = Boolean(window.productsState.mainPhotoFile || window.productsState.existingMainPhoto);
    if (!hasMainImage) {
        window.app.showToast('Main product image is required. Please upload a valid image before saving.', 'warning');
        document.querySelector('[data-target="tab-taxonomy"]').click();
        return;
    }

    // 2. Gather Pricing Data
    let price = null;
    let priceBefore = null;
    let stock = null;
    let sku = null;
    let options = [];

    if (window.productsState.hasVariants) {
        options = getVariantDataFromDOM();
        if (options.length === 0) {
            window.app.showToast(window.i18n.t('products.errVariantRow'), 'warning');
            document.querySelector('[data-target="tab-variants"]').click();
            return;
        }
    } else {
        price = parseFloat(document.getElementById('prod-price').value);
        priceBefore = document.getElementById('prod-price-before').value ? parseFloat(document.getElementById('prod-price-before').value) : null;
        stock = parseInt(document.getElementById('prod-stock').value);
        sku = document.getElementById('prod-sku').value.trim() || undefined;

        if (isNaN(price) || isNaN(stock)) {
            window.app.showToast(window.i18n.t('products.errPriceStock'), 'warning');
            document.querySelector('[data-target="tab-variants"]').click();
            return;
        }
    }

    const btn = document.getElementById('btn-save-product');
    const origText = btn.textContent;
    btn.innerHTML = `<i class="fa-solid fa-spinner fa-spin"></i> ${window.i18n.t('products.processing')}`;
    btn.disabled = true;

    try {
        // --- STEP 1: UPLOAD IMAGES IF ANY ---
        let mainPhotoUrl = window.productsState.existingMainPhoto || '';
        let sidePhotosUrls = [...window.productsState.existingSidePhotos];

        if (window.productsState.mainPhotoFile) {
            btn.innerHTML = `<i class="fa-solid fa-spinner fa-spin"></i> ${window.i18n.t('products.uploadingMainData')}`;
            const fd = new FormData();
            fd.append('image', window.productsState.mainPhotoFile);
            const uploadRes = await window.api.post('/api/admin/upload/single', fd);
            if (uploadRes && uploadRes.image_url) {
                mainPhotoUrl = uploadRes.image_url;
            } else {
                throw new Error('Main image upload succeeded but no image URL was returned.');
            }
        }

        // Upload new side photos
        for (let i = 0; i < window.productsState.sidePhotosFiles.length; i++) {
            const fd = new FormData();
            fd.append('image', window.productsState.sidePhotosFiles[i]);
            const uploadRes = await window.api.post('/api/admin/upload/single', fd);
            if (uploadRes && uploadRes.image_url) {
                sidePhotosUrls.push(uploadRes.image_url);
            } else {
                throw new Error(`Side image #${i + 1} upload succeeded but no image URL was returned.`);
            }
        }

        if (!mainPhotoUrl) {
            throw new Error('Main product image is required. Please upload a valid image before saving.');
        }

        // --- STEP 2: BUILD JSON PAYLOAD ---
        const payload = {
            gender,
            category_id: parseInt(categoryId),
            brand_id: parseInt(brandId),
            model,
            modelAr, // Injecting directly, API might drop it if not in schema, but good to have
            description_en: descEn,
            description_ar: descAr,
            price,
            price_before: priceBefore,
            stock,
            sku,
            is_active: isActive,
            main_photo_url: mainPhotoUrl,
            side_photos: sidePhotosUrls,
            options: window.productsState.hasVariants ? options : undefined,
            labels: Array.from(document.querySelectorAll('.prod-label-chk:checked')).map(cb => parseInt(cb.value))
        };

        const id = window.productsState.editingId;
        let createdProductId = id;

        // Save constraints API endpoint
        if (id) {
            await window.api.put(`/api/admin/products/${id}`, payload, false);
            window.app.showToast(window.i18n.t('products.productUpdated'));
        } else {
            const res = await window.api.post('/api/admin/products', payload, false);
            createdProductId = res.product ? res.product.id : (res.data && res.data.product ? res.data.product.id : null);
            window.app.showToast(window.i18n.t('products.productCreated'));
        }

        document.getElementById('product-modal').classList.remove('show');
        resetProductForm();
        await fetchAndRenderProducts();

    } catch (error) {
        window.app.showToast(error.message, 'error');
    } finally {
        btn.innerHTML = origText;
        btn.disabled = false;
    }
}

function resetProductForm() {
    document.getElementById('product-form').reset();
    window.productsState.editingId = null;
    window.productsState.hasVariants = false;
    window.productsState.mainPhotoFile = null;
    window.productsState.sidePhotosFiles = [];
    window.productsState.existingSidePhotos = [];
    window.productsState.existingMainPhoto = '';

    document.getElementById('prod-main-img-preview').src = 'https://via.placeholder.com/100';
    document.getElementById('prod-side-imgs-preview').innerHTML = '';
    document.getElementById('variants-container').innerHTML = '';
    document.getElementById('flat-pricing-section').style.display = 'block';
    document.getElementById('variants-builder-section').style.display = 'none';

    // Clear Labels
    document.querySelectorAll('.prod-label-chk').forEach(cb => cb.checked = false);
}

function closeProductsTrashModal() {
    const trashModal = document.getElementById('products-trash-modal');
    if (trashModal) {
        trashModal.classList.remove('show');
    }
}

function getProductDisplayName(prod) {
    const lang = window.i18n.currentLang || 'en';
    const fallbackName = prod.modelEn || prod.model || prod.name_en || prod.name || '-';
    return lang === 'ar'
        ? (prod.modelAr || prod.name_ar || fallbackName)
        : fallbackName;
}

function getProductPreviewImage(prod) {
    if (prod.mainPhotoUrl) return prod.mainPhotoUrl;
    if (prod.photos && prod.photos.length > 0) {
        return prod.photos.find(p => p.isMain)?.photoUrl || prod.photos[0].photoUrl;
    }
    if (prod.sidePhotos && prod.sidePhotos.length > 0) {
        return prod.sidePhotos[0];
    }
    return 'https://via.placeholder.com/80?text=No+Img';
}

function getProductPriceDisplay(prod) {
    if (prod.priceRange) {
        return prod.priceRange.min === prod.priceRange.max
            ? `EGP ${prod.priceRange.min}`
            : `EGP ${prod.priceRange.min} - ${prod.priceRange.max}`;
    }

    if (prod.price_after) return `EGP ${prod.price_after}`;
    if (prod.price) return `EGP ${prod.price}`;
    return '-';
}

function formatProductDeletedAt(value) {
    if (!value) return '-';

    try {
        return new Date(value).toLocaleString(window.i18n.currentLang === 'ar' ? 'ar-EG' : 'en-US');
    } catch (error) {
        return value;
    }
}

window.openProductsTrash = async () => {
    window.productsState.trashPage = 1;
    const trashModal = document.getElementById('products-trash-modal');
    trashModal.classList.add('show');
    await loadTrashProducts();
};

async function loadTrashProducts() {
    const listContainer = document.getElementById('products-trash-list');
    const infoContainer = document.getElementById('products-trash-info');
    const { trashPage, trashLimit } = window.productsState;

    listContainer.innerHTML = `
        <div style="text-align: center; color: var(--text-muted); padding: 2rem 0;">
            <i class="fa-solid fa-spinner fa-spin"></i>
        </div>
    `;

    try {
        const response = await window.api.get(`/api/admin/products/trash?page=${trashPage}&limit=${trashLimit}`);
        const products = Array.isArray(response) ? response : (response.products || []);
        const total = response?.total || products.length || 0;

        window.productsState.trashProducts = products;
        window.productsState.trashTotal = total;

        if (!products.length && total > 0 && trashPage > 1) {
            window.productsState.trashPage--;
            await loadTrashProducts();
            return;
        }

        infoContainer.textContent = (window.i18n.t('products.trashInfo') || 'Showing {count} product(s) in trash')
            .replace('{count}', total);

        document.getElementById('btn-products-trash-prev').disabled = trashPage <= 1;
        document.getElementById('btn-products-trash-next').disabled = products.length < trashLimit;

        if (!products.length) {
            listContainer.innerHTML = `
                <div style="text-align: center; color: var(--text-muted); padding: 2rem 0;">
                    ${window.i18n.t('products.trashEmpty') || 'Trash is empty'}
                </div>
            `;
            return;
        }

        listContainer.innerHTML = products.map(prod => `
            <div class="trash-product-card">
                <img src="${getProductPreviewImage(prod)}"
                     style="width: 80px; height: 80px; object-fit: cover; border-radius: 10px; background: #fff; border: 1px solid rgba(255,255,255,0.1);">
                <div>
                    <div style="font-weight: 700; color: var(--text-main);">${getProductDisplayName(prod)}</div>
                    <div style="font-size: 0.85rem; color: var(--text-muted); margin-top: 0.35rem;">
                        #${prod.id} | ${getProductPriceDisplay(prod)}
                    </div>
                    <div style="font-size: 0.8rem; color: var(--text-muted); margin-top: 0.35rem;">
                        ${window.i18n.t('products.deletedAtLabel') || 'Deleted at'}: ${formatProductDeletedAt(prod.deletedAt)}
                    </div>
                </div>
                <div class="trash-product-actions">
                    <button class="btn btn-outline btn-sm" onclick="restoreProduct(${prod.id})">
                        <i class="fa-solid fa-rotate-left"></i>
                        <span>${window.i18n.t('products.restoreProduct') || 'Restore'}</span>
                    </button>
                    <button class="btn btn-danger btn-sm" onclick="forceDeleteProduct(${prod.id})">
                        <i class="fa-solid fa-trash-can"></i>
                        <span>${window.i18n.t('products.permanentlyDelete') || 'Delete Permanently'}</span>
                    </button>
                </div>
            </div>
        `).join('');
    } catch (error) {
        infoContainer.textContent = window.i18n.t('products.loadTrashFailed') || 'Failed to load products trash';
        listContainer.innerHTML = `
            <div style="text-align: center; color: var(--danger); padding: 2rem 0;">
                ${error.message || (window.i18n.t('products.loadTrashFailed') || 'Failed to load products trash')}
            </div>
        `;
    }
}

window.restoreProduct = async (id) => {
    if (!id) return;
    if (!confirm(window.i18n.t('products.confirmRestoreProduct') || 'Restore this product from trash?')) return;

    try {
        await window.api.post(`/api/admin/products/${id}/restore`, {});
        window.app.showToast(window.i18n.t('products.restoreProductSuccess') || 'Product restored successfully');
        await Promise.all([loadTrashProducts(), fetchAndRenderProducts()]);
    } catch (error) {
        window.app.showToast(error.message || window.i18n.t('products.restoreProductFailed') || 'Failed to restore product', 'error');
    }
};

window.forceDeleteProduct = async (id) => {
    if (!id) return;
    if (!confirm(window.i18n.t('products.confirmPermanentDeleteProduct') || 'This will permanently delete the product from trash and cannot be undone. Continue?')) return;

    try {
        await window.api.delete(`/api/admin/products/${id}/force`);
        window.app.showToast(window.i18n.t('products.productPermanentlyDeleted') || 'Product permanently deleted');
        await Promise.all([loadTrashProducts(), fetchAndRenderProducts()]);
    } catch (error) {
        window.app.showToast(error.message || window.i18n.t('products.productPermanentDeleteFailed') || 'Failed to permanently delete product', 'error');
    }
};

/* --- LIST VIEW --- */
async function fetchAndRenderProducts() {
    try {
        const { page, limit } = window.productsState;

        // Grab filter values
        const search = document.getElementById('filter-search')?.value.trim() || '';
        const catId = document.getElementById('filter-category')?.value || '';
        const brandId = document.getElementById('filter-brand')?.value || '';
        const colorId = document.getElementById('filter-color')?.value || '';
        const labelId = document.getElementById('filter-label')?.value || '';
        const status = document.getElementById('filter-status')?.value || '';

        // Build URL
        let url = `/api/admin/products?page=${page}&limit=${limit}`;
        if (search) url += `&search=${encodeURIComponent(search)}`;
        if (catId) url += `&category_id=${catId}`;
        if (brandId) url += `&brand_id=${brandId}`;
        if (colorId) url += `&color_id=${colorId}`;
        if (labelId) url += `&label_id=${labelId}`;
        if (status) url += `&is_active=${status}`;

        const response = await window.api.get(url);

        let products = [];
        let total = 0;

        if (Array.isArray(response)) {
            products = response;
        } else if (response.products) {
            products = response.products;
            total = response.total || products.length;
        } else if (response.data) {
            products = response.data;
        }

        window.productsState.products = products;
        renderProductsTable(products);

        document.getElementById('prod-pagination-info').textContent = `${window.i18n.t('products.showingPage')}${page}${total ? window.i18n.t('products.showingPageTotal') + total + ')' : ''}`;
        document.getElementById('btn-prod-prev').disabled = page <= 1;
        document.getElementById('btn-prod-next').disabled = products.length < limit;

    } catch (e) {
        document.getElementById('products-tbody').innerHTML = `<tr><td colspan="6" style="text-align:center;color:var(--danger)">${window.i18n.t('products.loadFailed')}${e.message}</td></tr>`;
    }
}

function renderProductsTable(products) {
    const tbody = document.getElementById('products-tbody');
    if (!products || products.length === 0) {
        tbody.innerHTML = `<tr><td colspan="6" style="text-align: center;">${window.i18n.t('products.noProductsFound')}</td></tr>`;
        return;
    }

    tbody.innerHTML = products.map(prod => {
        const imgUrl = getProductPreviewImage(prod);

        const isPublished = prod.isActive !== false;
        const priceDisp = getProductPriceDisplay(prod);

        const lang = window.i18n.currentLang || 'en';
        let productName = getProductDisplayName(prod);
        
        let brandName = prod.brand?.nameEn || prod.brandId || '-';
        if (lang === 'ar') brandName = prod.brand?.nameAr || prod.brand?.name_ar || brandName;
        
        let categoryName = prod.category?.nameEn || prod.categoryId || '-';
        if (lang === 'ar') categoryName = prod.category?.nameAr || prod.category?.name_ar || categoryName;

        return `
            <tr>
                <td>#${prod.id || prod.productID || '-'}</td>
                <td>
                    <img src="${imgUrl}" 
                         style="width:50px; height:50px; object-fit:cover; border-radius:8px; background:#fff; border: 1px solid rgba(255,255,255,0.1);">
                </td>
                <td>
                    <div style="font-weight:600; color:var(--text-main);">${productName}</div>
                    <div style="font-size:0.75rem; color:var(--text-muted); margin-top:0.25rem;">
                        ${prod.variantAxes ? `<span class="badge badge-primary">${prod.variantAxes.join(',').toUpperCase() || 'FLAT'}</span>` : ''}
                        ${priceDisp}
                    </div>
                </td>
                <td>
                    <div style="font-size:0.85rem; font-weight: 500;">${brandName}</div>
                    <div style="font-size:0.75rem; color:var(--text-muted);">${categoryName}</div>
                </td>
                <td>
                    <span class="badge ${isPublished ? 'badge-success' : 'badge-danger'}">
                        ${isPublished ? window.i18n.t('products.active') : window.i18n.t('products.hidden')}
                    </span>
                    <div style="font-size:0.75rem; color:var(--text-muted); margin-top:4px;">${window.i18n.t('products.stockLabel')}${prod.totalStock !== undefined ? prod.totalStock : (prod.stock || 0)}</div>
                </td>
                <td style="text-align: right; white-space: nowrap;">
                    <button class="btn btn-icon btn-action-edit" onclick="editProduct(${prod.id || prod.productID})" title="Edit">
                        <i class="fa-solid fa-pen"></i>
                    </button>
                    <button class="btn btn-icon btn-action-delete" onclick="deleteProduct(${prod.id || prod.productID})" title="Delete">
                        <i class="fa-solid fa-trash"></i>
                    </button>
                </td>
            </tr>
        `;
    }).join('');
}

window.editProduct = async (id) => {
    try {
        const response = await window.api.get(`/api/admin/products/${id}`);
        const product = response.product || response.data?.product || response;
        if (!product) throw new Error("Product data missing");

        window.productsState.editingId = id;
        document.getElementById('product-modal-title').textContent = window.i18n.t('products.editProduct');

        // 1. Basic Fields
        document.getElementById('prod-model').value = product.modelEn || product.model || '';
        document.getElementById('prod-model-ar').value = product.modelAr || ''; // Note modelAr mapping issue in backend might exist
        document.getElementById('prod-gender').value = product.gender || 'unisex';
        document.getElementById('prod-is-active').value = product.isActive !== false ? 'true' : 'false';
        document.getElementById('prod-desc-en').value = product.descriptionEn || '';
        document.getElementById('prod-desc-ar').value = product.descriptionAr || '';

        // 2. Taxonomy Tab
        document.getElementById('prod-category').value = product.category?.id || product.categoryId || '';
        document.getElementById('prod-brand').value = product.brand?.id || product.brandId || '';

        // Main Image Preview
        if (product.mainPhotoUrl) {
            document.getElementById('prod-main-img-preview').src = product.mainPhotoUrl;
            window.productsState.existingMainPhoto = product.mainPhotoUrl;
        }

        // Labels
        document.querySelectorAll('.prod-label-chk').forEach(cb => cb.checked = false);
        if (product.labels && Array.isArray(product.labels)) {
            product.labels.forEach(l => {
                const lId = l.id;
                const cb = document.querySelector(`.prod-label-chk[value="${lId}"]`);
                if (cb) cb.checked = true;
            });
        }
        if (product.sidePhotos && product.sidePhotos.length > 0) {
            window.productsState.existingSidePhotos = product.sidePhotos;
            const previewContainer = document.getElementById('prod-side-imgs-preview');
            previewContainer.innerHTML = '';
            product.sidePhotos.forEach(url => {
                previewContainer.innerHTML += `
                    <div style="width: 60px; height: 60px; border-radius: 4px; overflow: hidden; border: 1px solid var(--border-color);">
                        <img src="${url}" style="width: 100%; height: 100%; object-fit: cover;">
                    </div>
                `;
            });
        }

        // 3. Pricing Tab
        // Detect if variant product
        const hasAxes = product.variantAxes && product.variantAxes.length > 0;
        document.getElementById('prod-has-variants').checked = hasAxes;

        if (hasAxes && product.variants) {
            // Unpack complex camelCase formatter object back to simple rows
            document.getElementById('flat-pricing-section').style.display = 'none';
            document.getElementById('variants-builder-section').style.display = 'block';

            const vContainer = document.getElementById('variants-container');
            vContainer.innerHTML = '';

            // Re-flatten the nested structure (colors -> sizes -> variants OR default -> etc)
            let flatRows = [];

            if (product.variants.colors && Array.isArray(product.variants.colors)) {
                product.variants.colors.forEach(cv => {
                    if (cv.sizes && cv.sizes.length > 0) {
                        cv.sizes.forEach(sv => {
                            flatRows.push({ option_id: sv.optionId, color_id: cv.colorId, price_after: sv.price, price_before: sv.compareAtPrice, stock: sv.stock, photos: sv.images });
                        });
                    } else {
                        flatRows.push({ option_id: cv.optionId, color_id: cv.colorId, price_after: cv.price, price_before: cv.compareAtPrice, stock: cv.stock, photos: cv.images });
                    }
                });
            } else if (product.variants.sizes && Array.isArray(product.variants.sizes)) {
                product.variants.sizes.forEach(sv => {
                    flatRows.push({ option_id: sv.optionId, color_id: null, price_after: sv.price, price_before: sv.compareAtPrice, stock: sv.stock, photos: sv.images });
                });
            }

            window.productsState.hasVariants = true;
            flatRows.forEach(row => addVariantRow(row));

        } else {
            // Flat Product
            document.getElementById('flat-pricing-section').style.display = 'block';
            document.getElementById('variants-builder-section').style.display = 'none';
            window.productsState.hasVariants = false;

            // Load flat metrics (from default variant fallback or root object)
            let flatP = null, flatPB = null, flatS = null, flatSku = null;
            if (product.variants && product.variants.default) {
                flatP = product.variants.default.price;
                flatPB = product.variants.default.compareAtPrice;
                flatS = product.variants.default.stock;
                flatSku = product.variants.default.sku;
            } else {
                flatP = product.price || product.price_after;
                flatPB = product.priceBefore || product.price_before;
                flatS = product.stock;
                flatSku = product.sku;
            }

            document.getElementById('prod-price').value = flatP || '';
            document.getElementById('prod-price-before').value = flatPB || '';
            document.getElementById('prod-stock').value = flatS || 0;
            document.getElementById('prod-sku').value = flatSku || '';
        }

        // Open Modal properly at Tab 1
        const modal = document.getElementById('product-modal');
        modal.classList.add('show');
        document.querySelector('[data-target="tab-basic"]').click();

    } catch (e) {
        window.app.showToast(window.i18n.t('products.loadProductFailed') + e.message, 'error');
    }
};

window.deleteProduct = async (id) => {
    if (!id) return;
    if (confirm(window.i18n.t('products.confirmDeleteProduct'))) {
        try {
            await window.api.post(`/api/admin/products/${id}/delete`, {});
            window.app.showToast(window.i18n.t('products.productDeleted'));
            await fetchAndRenderProducts();
        } catch (e) {
            window.app.showToast(e.message || window.i18n.t('products.moveToTrashFailed'), 'error');
        }
    }
};

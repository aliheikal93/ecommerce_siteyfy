/**
 * Home Sections ordering and visibility.
 */

const HOME_SECTION_LABELS = {
    shopByBrand: 'Shop by Brand',
    allCategories: 'All Categories',
    topSellers: 'Top Sellers',
    topViewed: 'Top Viewed',
    latestArrivals: 'Latest Arrivals',
    joinOurWorld: 'Join Our World',
};

window.homeSectionsState = {
    sections: [],
    headerCategoryBannersVisible: true,
};

window.initHomeSections = async () => {
    return `
        <div class="page-header">
            <div>
                <h2>Home Sections</h2>
                <p class="text-muted" style="color: var(--text-muted);">Control homepage section order and visibility.</p>
            </div>
            <button class="btn btn-primary" id="btn-save-home-sections">
                <i class="fa-solid fa-save"></i>
                <span>Save Changes</span>
            </button>
        </div>

        <div class="glass-card" style="padding: 1.5rem; margin-bottom: 1.5rem;">
            <div style="display:grid; grid-template-columns: 1fr 170px; gap:1rem; align-items:center;">
                <div>
                    <h3 style="margin:0 0 0.35rem; color:var(--text-main);">Header Category Banners</h3>
                    <p style="margin:0; color:var(--text-muted); font-size:0.9rem;">Show or hide the Women/Men category rows under the main header.</p>
                </div>
                <label style="display:flex; align-items:center; justify-content:flex-end; gap:0.65rem; color:var(--text-main); cursor:pointer; font-weight:700;">
                    <input type="checkbox" id="header-category-banners-visible" style="width:18px; height:18px;">
                    <span id="header-category-banners-label">Visible</span>
                </label>
            </div>
        </div>

        <div class="glass-card" style="padding: 1.5rem;">
            <div id="home-sections-list" style="display:flex; flex-direction:column; gap:0.85rem;"></div>
        </div>
    `;
};

window.setupHomeSectionsEvents = async () => {
    const listEl = document.getElementById('home-sections-list');
    const saveBtn = document.getElementById('btn-save-home-sections');
    const headerCategoryToggle = document.getElementById('header-category-banners-visible');
    const headerCategoryLabel = document.getElementById('header-category-banners-label');

    const render = () => {
        if (!listEl) return;

        if (headerCategoryToggle && headerCategoryLabel) {
            headerCategoryToggle.checked = Boolean(window.homeSectionsState.headerCategoryBannersVisible);
            headerCategoryLabel.textContent = window.homeSectionsState.headerCategoryBannersVisible ? 'Visible' : 'Hidden';
        }

        listEl.innerHTML = window.homeSectionsState.sections.map((section, index) => `
            <div class="home-section-row" data-section-key="${section.key}" style="display:grid; grid-template-columns: 54px 1fr 150px 112px; gap:1rem; align-items:center; padding:1rem; border:1px solid var(--border-color); border-radius:10px; background:rgba(15,23,42,0.45);">
                <div style="display:flex; gap:0.35rem;">
                    <button class="btn btn-sm btn-outline btn-home-section-up" ${index === 0 ? 'disabled' : ''} title="Move up" style="padding:0.45rem;">
                        <i class="fa-solid fa-chevron-up"></i>
                    </button>
                    <button class="btn btn-sm btn-outline btn-home-section-down" ${index === window.homeSectionsState.sections.length - 1 ? 'disabled' : ''} title="Move down" style="padding:0.45rem;">
                        <i class="fa-solid fa-chevron-down"></i>
                    </button>
                </div>
                <div>
                    <div style="font-weight:700; color:var(--text-main);">${HOME_SECTION_LABELS[section.key] || section.label || section.key}</div>
                    <div style="font-size:0.82rem; color:var(--text-muted);">Position ${index + 1}</div>
                </div>
                <label style="display:flex; align-items:center; gap:0.65rem; color:var(--text-main); cursor:pointer;">
                    <input type="checkbox" class="home-section-visible" ${section.isVisible ? 'checked' : ''} style="width:18px; height:18px;">
                    <span>${section.isVisible ? 'Visible' : 'Hidden'}</span>
                </label>
                <div style="display:flex; align-items:center; justify-content:flex-end; color:var(--text-muted); gap:0.5rem;">
                    <i class="fa-solid fa-grip-lines"></i>
                    <span>#${index + 1}</span>
                </div>
            </div>
        `).join('');
    };

    const moveSection = (key, direction) => {
        const currentIndex = window.homeSectionsState.sections.findIndex((section) => section.key === key);
        const nextIndex = currentIndex + direction;

        if (currentIndex < 0 || nextIndex < 0 || nextIndex >= window.homeSectionsState.sections.length) {
            return;
        }

        const sections = [...window.homeSectionsState.sections];
        const [section] = sections.splice(currentIndex, 1);
        sections.splice(nextIndex, 0, section);
        window.homeSectionsState.sections = sections.map((item, index) => ({
            ...item,
            sortOrder: index + 1,
        }));
        render();
    };

    try {
        const response = await window.api.get('/api/admin/settings/home-sections');
        window.homeSectionsState.headerCategoryBannersVisible = response.headerCategoryBannersVisible !== false;
        window.homeSectionsState.sections = (response.sections || []).map((section, index) => ({
            ...section,
            label: HOME_SECTION_LABELS[section.key] || section.label,
            sortOrder: index + 1,
        }));
        render();
    } catch (error) {
        window.app.showToast(`Failed to load home sections: ${error.message}`, 'error');
    }

    headerCategoryToggle?.addEventListener('change', (event) => {
        window.homeSectionsState.headerCategoryBannersVisible = event.target.checked;
        render();
    });

    listEl?.addEventListener('click', (event) => {
        const row = event.target.closest('.home-section-row');
        if (!row) return;

        const key = row.dataset.sectionKey;
        if (event.target.closest('.btn-home-section-up')) {
            moveSection(key, -1);
        }
        if (event.target.closest('.btn-home-section-down')) {
            moveSection(key, 1);
        }
    });

    listEl?.addEventListener('change', (event) => {
        const checkbox = event.target.closest('.home-section-visible');
        if (!checkbox) return;

        const row = checkbox.closest('.home-section-row');
        const key = row?.dataset.sectionKey;
        window.homeSectionsState.sections = window.homeSectionsState.sections.map((section) => (
            section.key === key
                ? { ...section, isVisible: checkbox.checked }
                : section
        ));
        render();
    });

    saveBtn?.addEventListener('click', async () => {
        const originalHtml = saveBtn.innerHTML;
        saveBtn.innerHTML = '<i class="fa-solid fa-spinner fa-spin"></i> Saving...';
        saveBtn.disabled = true;

        try {
            const sections = window.homeSectionsState.sections.map((section, index) => ({
                key: section.key,
                label: HOME_SECTION_LABELS[section.key] || section.label,
                isVisible: Boolean(section.isVisible),
                sortOrder: index + 1,
            }));

            const response = await window.api.put('/api/admin/settings/home-sections', {
                sections,
                headerCategoryBannersVisible: Boolean(window.homeSectionsState.headerCategoryBannersVisible),
            });
            window.homeSectionsState.sections = response.sections || sections;
            window.homeSectionsState.headerCategoryBannersVisible = response.headerCategoryBannersVisible !== false;
            render();
            window.app.showToast('Home sections updated successfully');
        } catch (error) {
            window.app.showToast(`Failed to save home sections: ${error.message}`, 'error');
        } finally {
            saveBtn.innerHTML = originalHtml;
            saveBtn.disabled = false;
        }
    });
};

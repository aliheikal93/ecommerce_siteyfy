window.setupCategoriesEvents = async () => {
    await fetchAndRenderCategories();

    const modal = document.getElementById('category-modal');

    // Main Image
    const imageInput = document.getElementById('cat-image-file');
    const imagePreview = document.getElementById('cat-image-preview');
    const imageMenInput = document.getElementById('cat-image-men-file');
    const imageMenPreview = document.getElementById('cat-image-men-preview');
    const imageWomenInput = document.getElementById('cat-image-women-file');
    const imageWomenPreview = document.getElementById('cat-image-women-preview');

    // Setup generic image previewer
    function setupFilePreview(inputId, previewId) {
        const input = document.getElementById(inputId);
        const preview = document.getElementById(previewId);
        if (!input || !preview) return;

        input.addEventListener('change', (e) => {
            if (e.target.files && e.target.files[0]) {
                const reader = new FileReader();
                reader.onload = (e) => {
                    preview.src = e.target.result;
                    preview.style.display = 'block';
                };
                reader.readAsDataURL(e.target.files[0]);
            }
        });
    }

    setupFilePreview('cat-image-file', 'cat-image-preview');
    setupFilePreview('cat-image-men-file', 'cat-image-men-preview');
    setupFilePreview('cat-image-women-file', 'cat-image-women-preview');
    setupFilePreview('cat-slider-desktop', 'cat-slider-desktop-preview');
    setupFilePreview('cat-slider-mobile', 'cat-slider-mobile-preview');
    setupFilePreview('cat-slider-men-desktop', 'cat-slider-men-desktop-preview');
    setupFilePreview('cat-slider-men-mobile', 'cat-slider-men-mobile-preview');
    setupFilePreview('cat-slider-women-desktop', 'cat-slider-women-desktop-preview');
    setupFilePreview('cat-slider-women-mobile', 'cat-slider-women-mobile-preview');


    const closeModal = () => {
        modal.classList.remove('show');
        document.getElementById('category-form').reset();

        // Reset previews
        imagePreview.src = '/uploads/logo.png';
        imagePreview.style.display = 'block';
        imageMenPreview.src = '/uploads/logo.png';
        imageMenPreview.style.display = 'block';
        imageWomenPreview.src = '/uploads/logo.png';
        imageWomenPreview.style.display = 'block';
        document.getElementById('cat-is-active').value = 'true';
        ['desktop', 'mobile', 'men-desktop', 'men-mobile', 'women-desktop', 'women-mobile'].forEach(type => {
            const el = document.getElementById(`cat-slider-${type}-preview`);
            if (el) {
                el.src = '';
                el.style.display = 'none';
            }
        });

        window.categoriesState.editingId = null;
    };

    document.getElementById('btn-add-category').addEventListener('click', () => {
        document.getElementById('category-modal-title').textContent = window.i18n.t('categories.addCategory');
        modal.classList.add('show');
    });

    document.getElementById('close-category-modal').addEventListener('click', closeModal);
    document.getElementById('btn-cancel-cat').addEventListener('click', closeModal);

    // Save Event
    document.getElementById('btn-save-cat').addEventListener('click', async () => {
        const slug = document.getElementById('cat-slug').value.trim();
        const name_en = document.getElementById('cat-name-en').value.trim();
        const name_ar = document.getElementById('cat-name-ar').value.trim();
        const is_active = document.getElementById('cat-is-active').value === 'true';

        if (!slug || !name_en || !name_ar) {
            window.app.showToast(window.i18n.t('categories.slugNamesRequired') || 'Slug and Names are required', 'warning');
            return;
        }

        const id = window.categoriesState.editingId;
        const btn = document.getElementById('btn-save-cat');
        const origText = btn.textContent;
        btn.innerHTML = `<i class="fa-solid fa-spinner fa-spin"></i> ${window.i18n.t('common.loading') || 'Saving...'}`;
        btn.disabled = true;

        try {
            const payload = {
                slug,
                name_en,
                name_ar,
                is_active
            };

            const uploadFile = async (file) => {
                const fd = new FormData();
                fd.append('image', file);
                const res = await window.api.post('/api/admin/upload/single', fd);
                return res?.image_url;
            };

            if (imageInput.files[0]) payload.image_url = await uploadFile(imageInput.files[0]);
            if (imageMenInput.files[0]) payload.image_url_men = await uploadFile(imageMenInput.files[0]);
            if (imageWomenInput.files[0]) payload.image_url_women = await uploadFile(imageWomenInput.files[0]);

            const fields = [
                { id: 'cat-slider-desktop', key: 'slider_image_desktop' },
                { id: 'cat-slider-mobile', key: 'slider_image_mobile' },
                { id: 'cat-slider-men-desktop', key: 'slider_image_men_desktop' },
                { id: 'cat-slider-men-mobile', key: 'slider_image_men_mobile' },
                { id: 'cat-slider-women-desktop', key: 'slider_image_women_desktop' },
                { id: 'cat-slider-women-mobile', key: 'slider_image_women_mobile' }
            ];

            for (const f of fields) {
                const input = document.getElementById(f.id);
                if (input && input.files[0]) {
                    payload[f.key] = await uploadFile(input.files[0]);
                }
            }

            if (id) {
                // Update
                await window.api.put(`/api/admin/categories/${id}`, payload);
                window.app.showToast(window.i18n.t('categories.updated') || 'Category updated successfully!');
            } else {
                // Create
                await window.api.post('/api/admin/categories', payload);
                window.app.showToast(window.i18n.t('categories.created') || 'Category created successfully!');
            }
            closeModal();
            await fetchAndRenderCategories();
        } catch (error) {
            window.app.showToast(error.message, 'error');
        } finally {
            btn.innerHTML = origText;
            btn.disabled = false;
        }
    });
};

async function fetchAndRenderCategories() {
    try {
        const response = await window.api.get('/api/admin/categories?includeInactive=true');
        const categories = Array.isArray(response) ? response : (response.categories || []);
        window.categoriesState.categories = categories;
        renderCategoriesTable(categories);
    } catch (e) {
        document.getElementById('categories-tbody').innerHTML = `<tr><td colspan="7" style="text-align:center;color:var(--danger)">Failed to load categories: ${e.message}</td></tr>`;
    }
}

function renderCategoriesTable(categories) {
    const tbody = document.getElementById('categories-tbody');
    if (!categories || categories.length === 0) {
        tbody.innerHTML = `<tr><td colspan="7" style="text-align: center;">${window.i18n.t('categories.noCategoriesFound') || 'No categories found'}</td></tr>`;
        return;
    }

    tbody.innerHTML = categories.map(cat => {
        // Fix broken links logic by resolving URL properties gracefully
        let img = cat.image?.url || cat.imageUrl || cat.image_url;
        if (!img || img === 'null' || img.startsWith('/undefined')) {
            img = '/uploads/logo.png';
        }

        return `
            <tr>
                <td>#${cat.id}</td>
                <td>
                    <img src="${img}" 
                         style="width:50px; height:50px; object-fit:cover; border-radius:8px; background:#fff;">
                </td>
                <td>${cat.name_en || cat.nameEn || ''}</td>
                <td dir="rtl" style="text-align:right">${cat.name_ar || cat.nameAr || ''}</td>
                <td><span class="badge badge-success">${cat.slug}</span></td>
                <td>
                    <span class="badge" style="background: ${(cat.is_active ?? cat.isActive) !== false ? 'rgba(34, 197, 94, 0.2)' : 'rgba(239, 68, 68, 0.2)'}; color: ${(cat.is_active ?? cat.isActive) !== false ? '#4ade80' : '#f87171'}">
                        ${(cat.is_active ?? cat.isActive) !== false ? (window.i18n.t('common.active') || 'Active') : (window.i18n.t('common.inactive') || 'Inactive')}
                    </span>
                </td>
                <td style="text-align: right; white-space: nowrap;">
                    <button class="btn btn-icon btn-action-edit" onclick="editCategory(${cat.id})" title="${window.i18n.t('common.edit') || 'Edit'}">
                        <i class="fa-solid fa-pen"></i>
                    </button>
                    <button class="btn btn-icon btn-action-delete" onclick="deleteCategory(${cat.id})" title="${window.i18n.t('common.delete') || 'Delete'}">
                        <i class="fa-solid fa-trash"></i>
                    </button>
                </td>
            </tr>
        `;
    }).join('');
}

window.editCategory = (id) => {
    const cat = window.categoriesState.categories.find(c => c.id === id);
    if (!cat) return;

    window.categoriesState.editingId = id;

    document.getElementById('category-modal-title').textContent = window.i18n.t('categories.editCategory') || 'Edit Category';
    document.getElementById('cat-slug').value = cat.slug || '';
    document.getElementById('cat-name-en').value = cat.nameEn || cat.name_en || '';
    document.getElementById('cat-name-ar').value = cat.nameAr || cat.name_ar || '';
    document.getElementById('cat-is-active').value = (cat.isActive ?? cat.is_active) !== false ? 'true' : 'false';

    // Main Images
    let img = cat.image?.url || cat.imageUrl || cat.image_url;
    if (!img || img === 'null' || img.startsWith('/undefined')) img = '/uploads/logo.png';
    document.getElementById('cat-image-preview').src = img;
    document.getElementById('cat-image-file').value = '';

    let imgMen = cat.imageUrlMen || cat.image_url_men;
    if (!imgMen || imgMen === 'null' || imgMen.startsWith('/undefined')) imgMen = '/uploads/logo.png';
    document.getElementById('cat-image-men-preview').src = imgMen;
    document.getElementById('cat-image-men-file').value = '';

    let imgWomen = cat.imageUrlWomen || cat.image_url_women;
    if (!imgWomen || imgWomen === 'null' || imgWomen.startsWith('/undefined')) imgWomen = '/uploads/logo.png';
    document.getElementById('cat-image-women-preview').src = imgWomen;
    document.getElementById('cat-image-women-file').value = '';

    // Setup initial previews for sliders if they exist
    const sliders = [
        { id: 'cat-slider-desktop', val: cat.sliderImageDesktop || cat.slider_image_desktop },
        { id: 'cat-slider-mobile', val: cat.sliderImageMobile || cat.slider_image_mobile },
        { id: 'cat-slider-men-desktop', val: cat.sliderImageMenDesktop || cat.slider_image_men_desktop },
        { id: 'cat-slider-men-mobile', val: cat.sliderImageMenMobile || cat.slider_image_men_mobile },
        { id: 'cat-slider-women-desktop', val: cat.sliderImageWomenDesktop || cat.slider_image_women_desktop },
        { id: 'cat-slider-women-mobile', val: cat.sliderImageWomenMobile || cat.slider_image_women_mobile }
    ];

    sliders.forEach(s => {
        document.getElementById(s.id).value = ''; // Reset file input
        const preview = document.getElementById(`${s.id}-preview`);
        if (s.val && s.val !== 'null' && !s.val.startsWith('/undefined')) {
            preview.src = s.val;
            preview.style.display = 'block';
        } else {
            preview.src = '';
            preview.style.display = 'none';
        }
    });

    const modal = document.getElementById('category-modal');
    modal.classList.add('show');
};

window.deleteCategory = async (id) => {
    if (confirm(window.i18n.t('categories.confirmDelete') || 'Are you sure you want to delete this category? It may break products linked to it.')) {
        try {
            await window.api.delete(`/api/admin/categories/${id}`);
            window.app.showToast(window.i18n.t('categories.deleted') || 'Category deleted successfully');
            await fetchAndRenderCategories();
        } catch (e) {
            window.app.showToast(e.message, 'error');
        }
    }
};

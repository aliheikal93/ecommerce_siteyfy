window.setupContentEvents = async () => {
    await fetchAndRenderContent();

    const modal = document.getElementById('content-modal');

    // Utility for previewing localized images
    function setupPreview(inputId, previewId) {
        document.getElementById(inputId).addEventListener('change', function (e) {
            const preview = document.getElementById(previewId);
            if (this.files && this.files[0]) {
                const reader = new FileReader();
                reader.onload = function (e) {
                    preview.src = e.target.result;
                }
                reader.readAsDataURL(this.files[0]);
            }
        });
    }

    setupPreview('content-desktop-file', 'content-desktop-preview');
    setupPreview('content-mobile-file', 'content-mobile-preview');
    setupPreview('content-general-file', 'content-general-preview');

    const closeModal = () => {
        modal.classList.remove('show');
        document.getElementById('content-form').reset();
        document.getElementById('content-desktop-preview').src = '/uploads/logo.png';
        document.getElementById('content-mobile-preview').src = '/uploads/logo.png';
        document.getElementById('content-general-preview').src = '/uploads/logo.png';
        window.contentState.editingId = null;
    };

    document.getElementById('btn-add-content').addEventListener('click', () => {
        document.getElementById('content-modal-title').textContent = window.i18n.t('content.addContent') || 'Add Home Content';
        modal.classList.add('show');
    });

    document.getElementById('close-content-modal').addEventListener('click', closeModal);
    document.getElementById('btn-cancel-content').addEventListener('click', closeModal);

    // Save Logic
    document.getElementById('btn-save-content').addEventListener('click', async () => {
        const type = document.getElementById('content-type').value;
        const sortOrder = parseInt(document.getElementById('content-sort').value) || 0;

        const title_en = document.getElementById('content-title-en').value.trim();
        const title_ar = document.getElementById('content-title-ar').value.trim();
        const subtitle_en = document.getElementById('content-subtitle-en').value.trim();
        const subtitle_ar = document.getElementById('content-subtitle-ar').value.trim();
        const btn_en = document.getElementById('content-btn-en').value.trim();
        const btn_ar = document.getElementById('content-btn-ar').value.trim();
        const link = document.getElementById('content-link').value.trim();

        // Files
        const deskFile = document.getElementById('content-desktop-file').files[0];
        const mobFile = document.getElementById('content-mobile-file').files[0];
        const genFile = document.getElementById('content-general-file').files[0];

        // Ensure at least one media exists if creating
        const isCreating = !window.contentState.editingId;
        if (isCreating && !deskFile && !mobFile && !genFile) {
            window.app.showToast(window.i18n.t('content.mediaRequired') || 'Please upload at least one media file (Desktop, Mobile, or General).', 'warning');
            return;
        }

        const btn = document.getElementById('btn-save-content');
        const origText = btn.textContent;
        btn.innerHTML = `<i class="fa-solid fa-spinner fa-spin"></i> ${window.i18n.t('common.saving') || 'Saving...'}`;
        btn.disabled = true;

        try {
            const payload = {
                type,
                sort_order: sortOrder,
                is_active: true
            };

            if (title_en) payload.title_en = title_en;
            if (title_ar) payload.title_ar = title_ar;
            if (subtitle_en) payload.subtitle_en = subtitle_en;
            if (subtitle_ar) payload.subtitle_ar = subtitle_ar;
            if (btn_en) payload.button_text_en = btn_en;
            if (btn_ar) payload.button_text_ar = btn_ar;
            if (link) {
                payload.button_link = link;
                payload.link_url = link;
            }

            // Upload files individually and append strings to payload
            const uploadFile = async (file) => {
                const fd = new FormData();
                fd.append('image', file); // Use image even for video, generic multer fallback handles mapping
                const res = await window.api.post('/api/admin/upload/single', fd);
                return res?.image_url;
            };

            if (deskFile) payload.media_url_desktop = await uploadFile(deskFile);
            if (mobFile) payload.media_url_mobile = await uploadFile(mobFile);
            if (genFile) payload.media_url = await uploadFile(genFile);

            const id = window.contentState.editingId;
            if (id) {
                await window.api.put(`/api/admin/content/${id}`, payload);
                window.app.showToast(window.i18n.t('content.updated') || 'Content updated successfully!');
            } else {
                await window.api.post('/api/admin/content', payload);
                window.app.showToast(window.i18n.t('content.created') || 'Content created successfully!');
            }

            closeModal();
            await fetchAndRenderContent();
        } catch (error) {
            window.app.showToast(error.message, 'error');
        } finally {
            btn.innerHTML = origText;
            btn.disabled = false;
        }
    });
};

async function fetchAndRenderContent() {
    try {
        const response = await window.api.get('/api/admin/content');
        const contents = Array.isArray(response) ? response : (response.contents || []);
        window.contentState.contents = contents;
        renderContentTable(contents);
    } catch (e) {
        document.getElementById('content-tbody').innerHTML = `<tr><td colspan="6" style="text-align:center;color:var(--danger)">${window.i18n.t('content.loadFailed') || 'Failed to load content'}: ${e.message}</td></tr>`;
    }
}

function renderContentTable(contents) {
    const tbody = document.getElementById('content-tbody');
    if (!contents || contents.length === 0) {
        tbody.innerHTML = `<tr><td colspan="6" style="text-align: center;">${window.i18n.t('content.noContentFound') || 'No content found'}</td></tr>`;
        return;
    }

    const lang = window.i18n.currentLang || 'en';

    tbody.innerHTML = contents.map(item => {
        // Derive thumbnail preview
        const img = item.media_url_desktop || item.media_url_mobile || item.media_url || '/uploads/logo.png';
        const isVideo = item.type === 'VIDEO';
        const title = lang === 'ar' ? (item.title_ar || item.title_en || '') : (item.title_en || item.title_ar || '');
        const noTitle = `<i class="text-muted">${window.i18n.t('content.noTitle') || 'No Title'}</i>`;

        return `
            <tr>
                <td>#${item.id}</td>
                <td>
                    ${isVideo && !img.match(/\.(jpeg|jpg|gif|png)$/i) ?
                '<i class="fa-solid fa-video fa-2x" style="color:var(--text-muted)"></i>' :
                `<img src="${img}" style="width:50px; height:50px; object-fit:cover; border-radius:8px; background:#fff;">`
            }
                </td>
                <td>${title || noTitle}</td>
                <td><span class="badge badge-success">${item.type}</span></td>
                <td>${item.sort_order}</td>
                <td style="text-align: right; white-space: nowrap;">
                    <button class="btn btn-icon btn-action-edit" onclick="editContent(${item.id})" title="${window.i18n.t('common.edit') || 'Edit'}">
                        <i class="fa-solid fa-pen"></i>
                    </button>
                    <button class="btn btn-icon btn-action-delete" onclick="deleteContent(${item.id})" title="${window.i18n.t('common.delete') || 'Delete'}">
                        <i class="fa-solid fa-trash"></i>
                    </button>
                </td>
            </tr>
        `;
    }).join('');
}

window.editContent = (id) => {
    const item = window.contentState.contents.find(c => c.id === id);
    if (!item) return;

    window.contentState.editingId = id;

    document.getElementById('content-modal-title').textContent = window.i18n.t('content.editContent') || 'Edit Content';

    document.getElementById('content-type').value = item.type;
    document.getElementById('content-sort').value = item.sort_order;
    document.getElementById('content-title-en').value = item.title_en || '';
    document.getElementById('content-title-ar').value = item.title_ar || '';
    document.getElementById('content-subtitle-en').value = item.subtitle_en || '';
    document.getElementById('content-subtitle-ar').value = item.subtitle_ar || '';
    document.getElementById('content-btn-en').value = item.button_text_en || '';
    document.getElementById('content-btn-ar').value = item.button_text_ar || '';
    document.getElementById('content-link').value = item.link_url || item.button_link || '';

    // Images reset / preview
    document.getElementById('content-desktop-file').value = '';
    document.getElementById('content-mobile-file').value = '';
    document.getElementById('content-general-file').value = '';

    document.getElementById('content-desktop-preview').src = item.media_url_desktop || '/uploads/logo.png';
    document.getElementById('content-mobile-preview').src = item.media_url_mobile || '/uploads/logo.png';
    document.getElementById('content-general-preview').src = item.media_url || '/uploads/logo.png';

    document.getElementById('content-modal').classList.add('show');
};

window.deleteContent = async (id) => {
    if (confirm(window.i18n.t('content.confirmDelete') || 'Are you sure you want to delete this content?')) {
        try {
            await window.api.delete(`/api/admin/content/${id}`);
            window.app.showToast(window.i18n.t('content.deleted') || 'Content deleted successfully');
            await fetchAndRenderContent();
        } catch (e) {
            window.app.showToast(e.message, 'error');
        }
    }
};

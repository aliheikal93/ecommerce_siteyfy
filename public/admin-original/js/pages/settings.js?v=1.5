window.setupSettingsEvents = async () => {

    // Sync color inputs
    const syncColor = (colorId, textId) => {
        const pC = document.getElementById(colorId);
        const pT = document.getElementById(textId);
        if (!pC || !pT) return;
        pC.addEventListener('input', (e) => pT.value = e.target.value.toUpperCase());
        pT.addEventListener('input', (e) => {
            if (/^#[0-9A-F]{6}$/i.test(e.target.value)) pC.value = e.target.value;
        });
    };
    syncColor('set-color-primary', 'set-color-primary-text');
    syncColor('set-color-secondary', 'set-color-secondary-text');

    // 1. Fetch current settings
    try {
        const response = await window.api.get('/api/admin/company-info');
        const info = response.company_info || response || {};

        document.getElementById('set-name-en').value = info.name_en || '';
        document.getElementById('set-name-ar').value = info.name_ar || '';
        document.getElementById('set-sitename-en').value = info.site_name_en || '';
        document.getElementById('set-sitename-ar').value = info.site_name_ar || '';
        document.getElementById('set-addr-en').value = info.address_en || '';
        document.getElementById('set-addr-ar').value = info.address_ar || '';
        document.getElementById('set-phone').value = info.phone || '';
        document.getElementById('set-whatsapp').value = info.whatsapp || '';
        document.getElementById('set-email').value = info.email || '';

        // Social Links
        document.getElementById('set-facebook').value = info.facebook_url || '';
        document.getElementById('set-instagram').value = info.instagram_url || '';
        document.getElementById('set-tiktok').value = info.tiktok_url || '';

        // Colors
        if (info.primary_color) {
            document.getElementById('set-color-primary').value = info.primary_color;
            document.getElementById('set-color-primary-text').value = info.primary_color;
        }
        if (info.secondary_color) {
            document.getElementById('set-color-secondary').value = info.secondary_color;
            document.getElementById('set-color-secondary-text').value = info.secondary_color;
        }

        // Images preview
        document.getElementById('set-logo-preview').src = info.logo_url || 'https://via.placeholder.com/150x50?text=No+Logo';
        document.getElementById('set-favicon-preview').src = info.favicon_url || 'https://via.placeholder.com/48?text=Ico';

    } catch (e) {
        window.app.showToast((window.i18n.t('settings.loadFailed') || 'Failed to load settings: ') + e.message, 'error');
    }

    // 2. Save Settings Handler (Text + Colors only)
    document.getElementById('btn-save-settings').addEventListener('click', async () => {
        const payload = {
            name_en: document.getElementById('set-name-en').value.trim(),
            name_ar: document.getElementById('set-name-ar').value.trim(),
            site_name_en: document.getElementById('set-sitename-en').value.trim(),
            site_name_ar: document.getElementById('set-sitename-ar').value.trim(),
            address_en: document.getElementById('set-addr-en').value.trim(),
            address_ar: document.getElementById('set-addr-ar').value.trim(),
            phone: document.getElementById('set-phone').value.trim(),
            whatsapp: document.getElementById('set-whatsapp').value.trim(),
            email: document.getElementById('set-email').value.trim(),
            facebook_url: document.getElementById('set-facebook').value.trim(),
            instagram_url: document.getElementById('set-instagram').value.trim(),
            tiktok_url: document.getElementById('set-tiktok').value.trim(),
            primary_color: document.getElementById('set-color-primary-text').value.trim() || undefined,
            secondary_color: document.getElementById('set-color-secondary-text').value.trim() || undefined,
        };

        if (!payload.name_en) {
            window.app.showToast(window.i18n.t('settings.nameRequired') || 'Company Name (EN) is required', 'warning');
            return;
        }

        const btn = document.getElementById('btn-save-settings');
        const origText = btn.innerHTML;
        btn.innerHTML = `<i class="fa-solid fa-spinner fa-spin"></i> ${window.i18n.t('common.saving') || 'Saving...'}`;
        btn.disabled = true;

        try {
            await window.api.put('/api/admin/company-info', payload);
            window.app.showToast(window.i18n.t('settings.savedSuccess') || 'Settings saved successfully!', 'success');
        } catch (e) {
            window.app.showToast(e.message, 'error');
        } finally {
            btn.innerHTML = origText;
            btn.disabled = false;
        }
    });

    // 3. Upload Logo Handler
    document.getElementById('btn-upload-logo').addEventListener('click', async () => {
        const fileInput = document.getElementById('set-logo-file');
        if (!fileInput.files.length) return window.app.showToast(window.i18n.t('settings.selectLogoFirst') || 'Please select a logo first', 'warning');

        const fd = new FormData();
        fd.append('logo', fileInput.files[0]);

        const btn = document.getElementById('btn-upload-logo');
        const origText = btn.innerHTML;
        btn.innerHTML = `<i class="fa-solid fa-spinner fa-spin"></i> ${window.i18n.t('common.uploading') || 'Uploading...'}`;
        btn.disabled = true;

        try {
            const res = await window.api.post('/api/admin/company-info/logo', fd);
            document.getElementById('set-logo-preview').src = res.logo_url;
            window.app.showToast(window.i18n.t('settings.logoUpdated') || 'Logo updated successfully!');
        } catch (e) {
            window.app.showToast(e.message, 'error');
        } finally {
            btn.innerHTML = origText;
            btn.disabled = false;
        }
    });

    // 4. Upload Favicon Handler
    document.getElementById('btn-upload-favicon').addEventListener('click', async () => {
        const fileInput = document.getElementById('set-favicon-file');
        if (!fileInput.files.length) return window.app.showToast(window.i18n.t('settings.selectFaviconFirst') || 'Please select a favicon first', 'warning');

        const fd = new FormData();
        fd.append('favicon', fileInput.files[0]);

        const btn = document.getElementById('btn-upload-favicon');
        const origText = btn.innerHTML;
        btn.innerHTML = `<i class="fa-solid fa-spinner fa-spin"></i> ${window.i18n.t('common.uploading') || 'Uploading...'}`;
        btn.disabled = true;

        try {
            const res = await window.api.post('/api/admin/company-info/favicon', fd);
            document.getElementById('set-favicon-preview').src = res.favicon_url;
            window.app.showToast(window.i18n.t('settings.faviconUpdated') || 'Favicon updated successfully!');
        } catch (e) {
            window.app.showToast(e.message, 'error');
        } finally {
            btn.innerHTML = origText;
            btn.disabled = false;
        }
    });
};

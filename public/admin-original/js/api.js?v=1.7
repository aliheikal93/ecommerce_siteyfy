/**
 * API Wrapper for Vanilla JS Dashboard
 * Handles fetch requests, JWT tokens, and global error processing.
 */

class ApiService {
    constructor() {
        this.baseUrl = window.location.origin; // Dynamically grab origin, e.g., https://premiumbrand.sitefi.cloud
    }

    // Helper to get headers with JWT token
    getHeaders(isFormData = false) {
        const token = localStorage.getItem('admin_token');
        const headers = {
            'Accept': 'application/json'
        };

        if (token) {
            headers['Authorization'] = `Bearer ${token}`;
        }

        // If it's not FormData (e.g. JSON), add Content-Type
        if (!isFormData) {
            headers['Content-Type'] = 'application/json';
        }

        return headers;
    }

    // Generic request handler
    async request(endpoint, options = {}) {
        try {
            const response = await fetch(`${this.baseUrl}${endpoint}`, options);

            // Handle 401 Unauthorized globally
            if (response.status === 401) {
                // Clear token and redirect if not already on login page
                localStorage.removeItem('admin_token');
                localStorage.removeItem('admin_user');
                if (window.app && window.app.currentView !== 'login-view') {
                    window.app.switchView('login-view');
                    window.app.showToast('Session expired. Please login again.', 'error');
                }
                throw new Error('Unauthorized');
            }

            let data = null;
            try {
                data = await response.json();
            } catch (parseError) {
                throw new Error(`Invalid server response (${response.status}). Please try again or contact support.`);
            }

            // API uses {success: true/false} pattern
            if (!data.success) {
                const details = Array.isArray(data.error?.details) && data.error.details.length
                    ? `: ${data.error.details.map((d) => d.message || d.field || d).join(', ')}`
                    : '';
                const errMsg = `${data.error?.message || 'An error occurred'}${details}`;
                throw new Error(errMsg);
            }

            return data.data;

        } catch (error) {
            console.error(`API Error on ${endpoint}:`, error);
            throw error;
        }
    }

    // GET Request
    async get(endpoint) {
        return this.request(endpoint, {
            method: 'GET',
            headers: this.getHeaders()
        });
    }

    // POST Request
    async post(endpoint, payload) {
        const isFormData = payload instanceof FormData;
        return this.request(endpoint, {
            method: 'POST',
            headers: this.getHeaders(isFormData),
            body: isFormData ? payload : JSON.stringify(payload)
        });
    }

    // PUT Request
    async put(endpoint, payload) {
        return this.request(endpoint, {
            method: 'PUT',
            headers: this.getHeaders(),
            body: JSON.stringify(payload)
        });
    }

    // PATCH Request
    async patch(endpoint, payload) {
        return this.request(endpoint, {
            method: 'PATCH',
            headers: this.getHeaders(),
            body: JSON.stringify(payload)
        });
    }

    // DELETE Request
    async delete(endpoint) {
        return this.request(endpoint, {
            method: 'DELETE',
            headers: this.getHeaders()
        });
    }

    // Specific API Method: Auth Login
    async login(email, password) {
        return this.post('/api/admin/auth/login', { email, password });
    }
}

// Export singleton instance
window.api = new ApiService();
